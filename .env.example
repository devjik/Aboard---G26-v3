# Database URL — PostgreSQL (Supabase or local Docker)
# Local Docker: postgresql://aboard:aboarddev@localhost:5432/aboard?schema=public
# Supabase:     postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL="postgresql://aboard:aboarddev@localhost:5432/aboard?schema=public"

# Session secret — MUST be 32+ characters. Generate with: openssl rand -hex 32
ABOARD_SESSION_SECRET="change-me-to-a-32-char-min-secret"

# Payment sandbox key (dev only — real provider keys go in Vercel env vars)
ABOARD_PAYMENT_SANDBOX_KEY="change-me"

# Supabase Realtime (for live driver GPS tracking)
# Get these from: Supabase Dashboard → Settings → API
# If not set, the app falls back to simulated driver positions on the live map.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
